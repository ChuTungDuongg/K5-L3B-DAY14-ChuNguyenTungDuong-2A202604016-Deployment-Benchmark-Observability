# Giá trị mẫu cho local. Chỉ file .env.example được commit.
PORT=8000
ENVIRONMENT=development
AGENT_API_KEY=replace-with-your-local-key
# Python chạy trên máy dùng localhost; Compose tự đổi thành redis://redis:6379/0.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
# Tuỳ chọn: giới hạn thêm theo tháng; bỏ trống nếu chỉ dùng giới hạn ngày.
MONTHLY_BUDGET_USD=10.0
LOG_LEVEL=INFO
